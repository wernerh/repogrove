# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js
.next/
out/
build/
dist/
next-env.d.ts
*.tsbuildinfo

# Env files — never commit real secrets
.env
.env.local
.env.*.local
!.env.example

# Data exports — never commit real scraped/user data
*.xlsx
*.xls
*.csv
!content/**/*.csv
*.sqlite
*.sqlite3
*.db
!**/fixtures/**
# Exception: the RepositorySnapshot store is a deliberate, ADR-005-documented build
# artifact of public GitHub repo metrics (stars/forks/open_issues), never real user data
# or secrets — the scheduled ingestion job is the only writer, see ADR-005.
!data/repogrove.db

# Keys and credentials
*.pem
*.key
*.p12
*secret*
!**/*secret*.md

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Logs
*.log
npm-debug.log*

# Coverage
coverage/

# Playwright (design lane's screenshot + a11y harness — see playwright.config.ts)
test-results/
playwright-report/
blob-report/
playwright/.cache/
